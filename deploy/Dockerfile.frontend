# Dockerfile generico para los frontends Next.js (suit-panel, suit-portal).
# Build context = raiz del monorepo. SERVICE_DIR selecciona el servicio:
#   docker build -f deploy/Dockerfile.frontend --build-arg SERVICE_DIR=suit-panel .
#   docker build -f deploy/Dockerfile.frontend --build-arg SERVICE_DIR=suit-portal .

# ────────────────────────────────────────
# STAGE 1: base
# ────────────────────────────────────────
FROM node:22-alpine AS base

WORKDIR /app

# ────────────────────────────────────────
# STAGE 2: deps
# ────────────────────────────────────────
FROM base AS deps

ARG SERVICE_DIR
COPY ${SERVICE_DIR}/package.json ${SERVICE_DIR}/package-lock.json ./
RUN npm ci

# ────────────────────────────────────────
# STAGE 3: tester
# ────────────────────────────────────────
FROM deps AS tester

ARG SERVICE_DIR
COPY ${SERVICE_DIR}/ .
RUN npm run lint

# ────────────────────────────────────────
# STAGE 4: builder
# ────────────────────────────────────────
FROM deps AS builder

ARG SERVICE_DIR
COPY ${SERVICE_DIR}/ .

# Next.js "hornea" las variables NEXT_PUBLIC_* en el bundle del cliente
# durante el build, no en runtime — el .env real está excluido a propósito
# del build context (.dockerignore raíz), así que sin esto el bundle queda
# con los defaults hardcodeados en el código, no los valores reales.
ARG NEXT_PUBLIC_CONCILIACION_DOCS_URL
ARG NEXT_PUBLIC_ORQUESTADOR_PUBLIC_URL
ENV NEXT_PUBLIC_CONCILIACION_DOCS_URL=${NEXT_PUBLIC_CONCILIACION_DOCS_URL}
ENV NEXT_PUBLIC_ORQUESTADOR_PUBLIC_URL=${NEXT_PUBLIC_ORQUESTADOR_PUBLIC_URL}

RUN npm run build

# ────────────────────────────────────────
# STAGE 5: runner
# ────────────────────────────────────────
FROM node:22-alpine AS runner

ENV PORT=3000
ENV NODE_ENV=production
WORKDIR /app

COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./
COPY --from=builder /app/.next ./.next
COPY --from=builder /app/public ./public

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s \
  CMD wget --no-verbose --tries=1 --spider http://localhost:3000 || exit 1

CMD ["npm", "start"]
