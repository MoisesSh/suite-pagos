# Backend suit-conciliacion (server-only, nunca expuesta al cliente)
CONCILIACION_API_URL=http://localhost:8000

# Backend suit-orquestador — admin de AplicacionRegistrada/DominioPermitido.
# Token de servicio propio de suit-panel (TokenAuthentication + IsAdminUser
# de rest_framework.authtoken, no relacionado con el login JWT de arriba).
# No reusar el ORQUESTADOR_ADMIN_TOKEN de suit-portal — token propio por app.
ORQUESTADOR_API_URL=http://localhost:8001
ORQUESTADOR_ADMIN_TOKEN=

# NextAuth
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# E2E (Playwright, ver e2e/global.setup.ts) — credenciales de un usuario
# de prueba existente en el stack contra el que se corran los tests.
TEST_USER=
TEST_PASS=
