# Worker Celery — solo suit-conciliacion (consume la cola pago.* de RabbitMQ,
# hace polling a la API de conciliacion de BDV). suit-orquestador NO tiene
# worker Celery propio: su relay outbox->RabbitMQ es un poller via Celery beat
# dentro del mismo proceso backend, no un worker separado (ver deploy/README.md).
# Build context = raiz del monorepo.

FROM python:3.13-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends gcc libpq-dev \
    && rm -rf /var/lib/apt/lists/*

FROM base AS deps

COPY suit-conciliacion/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

FROM deps AS runner

COPY suit-conciliacion/ .

# --without-gossip/--without-mingle/--without-heartbeat: RabbitMQ 4.x rechaza
# las colas transitorias exclusivas que gossip/mingle declaran para
# coordinacion entre workers (error 541 transient_nonexcl_queues, mismo
# problema que ya se resolvio para el pidbox via
# CELERY_WORKER_ENABLE_REMOTE_CONTROL=False en settings.py, pero esa variable
# no cubre gossip/mingle). Sin esto el worker crashea en loop y nunca llega a
# consumir nada ni a registrarse en Flower.
CMD ["celery", "-A", "config", "worker", "--loglevel=info", "--concurrency=4", "--without-gossip", "--without-mingle", "--without-heartbeat"]
