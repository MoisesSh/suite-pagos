# QA/SANDBOX UNICAMENTE — API key dummy documentada en
# "Doc- API Conciliacion Dummy.pdf" (raiz del monorepo), ambiente Calidad de
# BDV. Nunca usar en produccion sin reemplazar por la key real del banco.
BDV_CONCILIACION_BASE_URL=https://bdvconciliacionqa.banvenez.com:444
BDV_CONCILIACION_API_KEY=

# Obligatoria, sin fallback a sqlite (config/settings.py falla rapido si
# falta). Para desarrollo local contra el Postgres real de Docker, usar el
# puerto expuesto al host (ver deploy/docker-compose.yml, hoy 5434) con las
# credenciales de deploy/.env (CONCILIACION_DB_*).
DATABASE_URL=postgres://postgres:PASSWORD@localhost:5434/conciliacion_pagos

# Obligatoria por env. Generar con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# IMPORTANTE: nunca uses el caracter '$' — Docker Compose interpola $VAR
# dentro de los .env leidos via env_file y lo borra en silencio (ver
# PLAN-DE-MEJORAS.md Bloque #18).
SECRET_KEY=

# Clave propia de este servicio (no compartir con suit-orquestador). Generar
# con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEYS=

# Origenes de navegador autorizados a llamar esta API con cookies (JWT +
# refresh HttpOnly). Obligatorio, explicito — sin fallback a CORS abierto.
CORS_ALLOWED_ORIGINS=http://localhost:3000
