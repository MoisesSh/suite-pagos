# Postgres (desarrollo local, fuera de Docker)
DB_NAME=orquestador_pagos
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Desarrollo local unicamente — Docker/produccion lo setean explicito por env
DEBUG=True

# Obligatorias, sin default (Bloque #15 — la clave original quedo hardcodeada
# y comprometida en git). Generar con:
#   python -c "import secrets,string; print(''.join(secrets.choice(string.ascii_letters+string.digits+'!@%^&*()_+-=') for _ in range(50)))"
# IMPORTANTE: nunca uses el caracter '$' en estos valores — Docker Compose
# interpola $VAR dentro de los .env leidos via env_file y lo borra en
# silencio (ver PLAN-DE-MEJORAS.md Bloque #18).
SECRET_KEY=
CHECKOUT_TOKEN_SIGNING_KEY=
FIELD_ENCRYPTION_KEYS=

# Limite maximo de monto por transaccion (Bloque #15). Opcional, default
# 50000.00 si se omite (ver settings.py).
MONTO_MAXIMO_TRANSACCION=50000.00

# Webhook server-to-server (Bloque #17 parte 2). Opcionales, tienen default
# seguro en settings.py — no rompen el arranque si se omiten.
WEBHOOK_MAX_INTENTOS=10
WEBHOOK_TIMEOUT_SEGUNDOS=5

# QA/sandbox unicamente, rotar antes de produccion
BDV_C2P_BASE_URL=https://bdvconciliacionqa.banvenez.com:444
BDV_C2P_API_KEY=
BDV_C2P_TELEFONO_COMERCIO=
