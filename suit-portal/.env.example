# URL del visor Swagger de suit-conciliacion (único backend con OpenAPI expuesto hoy).
# suit-orquestador todavia no expone /api/docs/ — ver CONTRATO-API-ACTUAL.md.
NEXT_PUBLIC_CONCILIACION_DOCS_URL=http://localhost:8000/api/docs/

# suit-orquestador — CRUD admin de registro de aplicaciones/dominios.
# Server-only (nunca prefijo NEXT_PUBLIC_): el token se genera desde Django
# admin (/admin/authtoken/tokenproxy/) por un superuser. Ver CONTRATO-API-ACTUAL.md,
# seccion "Admin — registro de apps/dominios".
ORQUESTADOR_API_URL=http://localhost:8001
ORQUESTADOR_ADMIN_TOKEN=
