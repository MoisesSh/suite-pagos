# Credenciales de las 2 bases Postgres separadas (database-per-service).
ORQUESTADOR_DB_USER=postgres
ORQUESTADOR_DB_PASSWORD=
ORQUESTADOR_DB_NAME=orquestador_pagos

CONCILIACION_DB_USER=postgres
CONCILIACION_DB_PASSWORD=
CONCILIACION_DB_NAME=conciliacion_pagos

# RabbitMQ — cambiar el default guest/guest antes de exponer este stack mas
# alla de dev/staging (el compose actual publica el puerto de management y
# AMQP al host, ver PLAN-DE-MEJORAS.md Bloque #17 parte 1, sin resolver).
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# --- Opcionales, con default seguro en docker-compose.yml si se omiten ---

# DEBUG de suit-conciliacion en Docker (default True — este stack es de
# dev/staging, sirve /api/docs/ a proposito). Poner False para simular
# produccion.
# DEBUG=True

# Origenes de navegador autorizados en suit-conciliacion (CORS). Default ya
# cubre el panel (suit-panel:3000) y el Developer Portal (suit-portal:3001).
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Origen del Developer Portal autorizado a embeber /api/docs/ y /api/schema/
# de suit-conciliacion por iframe.
# PORTAL_ORIGIN=http://localhost:3001
