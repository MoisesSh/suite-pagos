# URL del visor Swagger de suit-conciliacion (único backend con OpenAPI expuesto hoy).
# suit-orquestador todavia no expone /api/docs/ — ver CONTRATO-API-ACTUAL.md.
NEXT_PUBLIC_CONCILIACION_DOCS_URL=http://localhost:8000/api/docs/

# suit-orquestador — server-only, usado por /probar-iframe para
# POST /api/autorizacion/validar-acceso/ (AllowAny, no requiere token).
# El registro de aplicaciones/dominios ya no vive en este portal — se
# gestiona desde suit-panel (panel interno de staff).
ORQUESTADOR_API_URL=http://localhost:8001

# URL publica (alcanzable por el navegador) de suit-orquestador, para el `src`
# del iframe de /probar-iframe. Puede diferir de ORQUESTADOR_API_URL si ese
# ultimo apunta a un hostname interno de docker (ej. http://suit-orquestador:8000)
# mientras el navegador solo puede llegar por el puerto publicado.
NEXT_PUBLIC_ORQUESTADOR_PUBLIC_URL=http://localhost:8001
